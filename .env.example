# Copy to .env (same folder) and fill in. .env is gitignored.

# ---- Agentic Issue Classifier ----
# Default backend is "groq"; set key below. Alternatives: openai | hf_local
AIC_LLM_BACKEND=groq
GROQ_API_KEY=
AIC_GROQ_MODEL=openai/gpt-oss-120b
# Optional override; leave blank to use ChatGroq's default endpoint.
# AIC_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Only used when AIC_LLM_BACKEND=openai
# OPENAI_API_KEY=
# AIC_OPENAI_MODEL=gpt-4o-mini

# Only used when AIC_LLM_BACKEND=hf_local
# AIC_HF_MODEL=google/flan-t5-large
